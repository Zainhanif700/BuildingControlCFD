CLAUDE.md
.CLAUDE.md

# Only these are excluded -- multiple GB each, GitHub hard-rejects files
# over 100MB and these need Git LFS otherwise. Everything else (code,
# checkpoints, small data files) is tracked so the repo is self-contained.
learning/dataset/*.pkl
local/processed_data/
local/raw_data/
local/steady_case_data/

# Python build artifacts -- never belong in version control.
__pycache__/
*.pyc
.ipynb_checkpoints/

# Loose .pt files directly in checkpoints/ are typically stray duplicates of
# local/models/ -- only the ensemble_5/ subfolder (our retrained ensemble)
# should be tracked here.
learning/data/checkpoints/*.pt

# GNOT training outputs on the server -- regenerated by every run, never committed.
# The checkpoint that matters for each version is copied into its
# experiments/gnot/milestones/<version>/ folder and committed from there.
# (Files already tracked, e.g. old checkpoints/gnot_final.pth, stay tracked.)
experiments/gnot/checkpoints/
experiments/gnot/*.log
# stray git artefact that appeared inside experiments/gnot on the server
experiments/gnot/FETCH_HEAD
# OpenFOAM reference cases (meshes + fields, GBs) -- regenerate with openfoam/make_openfoam_case.py
experiments/gnot/openfoam/cases/
# leftover local copy of the removed PINTO experiment folder on the server
experiments/pinto/
# Track 2 (experiments/gnot_openfoam): extracted datasets, checkpoints and logs are regenerated on the server
experiments/gnot_openfoam/data/
experiments/gnot_openfoam/checkpoints/
experiments/gnot_openfoam/logs/
